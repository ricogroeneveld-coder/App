# Copy this file to .env.local and fill in your Supabase project's values.
# Find both of these in your Supabase project: Settings → API.

# Project URL, e.g. https://abcdefghijk.supabase.co
VITE_SUPABASE_URL=

# The "anon" / "public" key (NOT the service_role key — that one must never
# ship in frontend code). This app has no login system and relies entirely
# on the RLS policies in supabase/migrations/0001_init.sql, which are wide
# open by design (see the comment at the top of that file).
VITE_SUPABASE_ANON_KEY=
