# Copy this file to .env.local and fill in your Supabase project's values.
# Find both of these in your Supabase project: Settings → API.

# Project URL, e.g. https://abcdefghijk.supabase.co
VITE_SUPABASE_URL=

# The "anon" / "public" key (NOT the service_role key — that one must never
# ship in frontend code). This app has no login system and relies entirely
# on the RLS policies in supabase/migrations/0001_init.sql, which are wide
# open by design (see the comment at the top of that file).
VITE_SUPABASE_ANON_KEY=

# Leave unset for every real build (local dev, web production, TestFlight,
# App Store). Only set to 1 for an internal QA build you're testing on a
# real device — it's what lets the ?dev=unlock / ?dev=reset URL params (test
# mode, profile reset, simulated web purchases) do anything at all. Without
# it, those URLs are inert no matter who visits them.
# VITE_ENABLE_DEV_TOOLS=1

# Push notifications. Leave UNSET until the iOS build actually carries the
# aps-environment entitlement (see ios/App/App/App.entitlements). While it's
# unset the app never shows the "Allow notifications?" prompt and never calls
# the notify-turn function — so it can't ask for a permission it has no way to
# honor. Set to 1 in the same change that restores the entitlement.
# VITE_PUSH_ENABLED=1

# Where public/privacy.html, support.html and terms.html are published.
# Optional: src/lib/links.js already defaults to the live location. Set this
# only if those pages move, and include the full path, not just the domain.
# VITE_SITE_BASE=https://www.jinnieoclock.com/whatsmypick
