<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.developer.ubiquity-kvstore-identifier</key>
	<string>$(TeamIdentifierPrefix)$(CFBundleIdentifier)</string>
	<!-- PUSH IS CURRENTLY DISABLED IN THIS BUILD (LAUNCH-2 deferred).
	     The app's push code is complete (src/lib/push.js, the push_tokens
	     table, the notify-turn Edge Function) but the entitlement is removed
	     because the App Store provisioning profile does not yet carry
	     aps-environment, which makes the archive fail to sign. Without the
	     entitlement, registerPush() never gets a token and notify-turn sends
	     nothing — turn reminders simply don't arrive.

	     TO RE-ENABLE (all on a computer, ~5 min):
	       1. developer.apple.com -> Identifiers -> com.whatsmypick.app ->
	          tick Push Notifications -> Save (reload to confirm it stuck).
	       2. Profiles -> DELETE the WhatsMyPick profile -> create a new App
	          Store profile -> Download. (Editing the old one often reissues
	          it without push.)
	       3. base64 the .mobileprovision and put it in the
	          IOS_PROVISIONING_PROFILE GitHub secret.
	       4. Uncomment the two lines below.
	     CI checks these two stay consistent: if this key is present, the
	     profile MUST carry it; if absent, the build warns that push is off.

	<key>aps-environment</key>
	<string>production</string>
	-->

</dict>
</plist>
